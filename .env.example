# ── API keys ──────────────────────────────────────────────────────────────────
# Gemini: image OCR / vision descriptions (and embeddings, if enabled).
GEMINI_API_KEY=""

# Groq: fast layout classification. Free tier.
GROQ_API_KEY=""

# NVIDIA NIM: build.nvidia.com — free, no credit card, key starts with "nvapi-".
# Used for higher-quality rewriting and quiz generation, and as automatic
# failover when Groq returns 429. Accessed over plain REST; the OpenAI SDK is
# NOT used and is not a dependency.
NVIDIA_API_KEY=""
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# ── Clerk authentication ──────────────────────────────────────────────────────
# Publishable key (safe for the client). The frontend reads its own copy from
# frontend/.env as VITE_CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=""
# Secret key — server only. Never commit a real value.
CLERK_SECRET_KEY=""

# ── Runtime safety flags ──────────────────────────────────────────────────────
# These pin numeric libraries to a single thread. They are applied in code by
# learnova.config.apply_runtime_env(), so setting them here is optional.
PYDANTIC_DISABLE_PLUGINS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
NUMEXPR_NUM_THREADS=1
KMP_DUPLICATE_LIB_OK=TRUE

# ── Phone + OTP authentication ────────────────────────────────────────────────
# SQLite file holding users, profiles, OTPs and sessions (default .data/learnova.db).
# LEARNOVA_DB_PATH=""
# LEARNOVA_AUTH=off disables auth entirely (anonymous single user).
# HMAC key for OTP hashes — set a long random value in production.
OTP_SECRET=""
# 1 = API echoes the OTP back so you can log in without an SMS account. NEVER in production.
OTP_DEV_MODE=1
# console (logs the code) | twilio
OTP_SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
# DEFAULT_COUNTRY_CODE=91

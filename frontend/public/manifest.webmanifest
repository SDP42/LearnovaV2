{
  "name": "Learnova — AI Presentation Engine",
  "short_name": "Learnova",
  "description": "Turn lecture notes, PDFs and slide decks into designed, interactive presentations with quizzes and step-by-step explainers.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FFFAF5",
  "theme_color": "#402B25",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New deck", "url": "/app/create" },
    { "name": "My decks", "url": "/app/presentations" },
    { "name": "Solve step by step", "url": "/app/explain" }
  ]
}
